# HTTPS (Let's Encrypt) for the pages, overlay, API and WebSocket feeds.
# Passkeys (Mera) are bound to the host name, so each network keeps its own address:
#   DOMAIN          → mainnet (MAIN_UPSTREAM; the testnet server until mainnet is deployed)
#   testnet.DOMAIN  → testnet
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy {$MAIN_UPSTREAM}
}

testnet.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy server:8787
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
