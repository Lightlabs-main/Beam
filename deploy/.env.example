# Copy to deploy/.env on the VPS. Never commit the real file.
DOMAIN=beam.example.com
BEAM_NETWORK=testnet

RELAYER_PRIVATE_KEY=
RELAYER_MIN_BALANCE_MON=0.5
MIN_GIFT_USDC=0.1
RELAY_PER_MINUTE=20
# Optional hosted on-ramp URL; use {address} where the wallet address belongs.
RAMP_URL=

# https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=
# Generate with: openssl rand -hex 32
ENVIO_PG_PASSWORD=
HASURA_ADMIN_SECRET=

# Beam Twitch chat bot (optional). Register an app at https://dev.twitch.tv/console:
#   OAuth redirect URLs (add both): https://<DOMAIN>/twitch/bot/callback and https://<DOMAIN>/twitch/link/callback
#   Category: Chat Bot   Client type: Confidential
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Generate with: openssl rand -hex 16 (guards https://<DOMAIN>/twitch/bot/connect?key=...)
TWITCH_BOT_ADMIN_KEY=
