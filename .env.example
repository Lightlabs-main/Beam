# Which deployment in contracts/deployments/ to use: testnet | mainnet
BEAM_NETWORK=testnet

# Relayer hot wallet: pays gas for gifts and claims. Keep only operating MON in it.
RELAYER_ADDRESS=
RELAYER_PRIVATE_KEY=
# Sponsorship bounds
RELAYER_MIN_BALANCE_MON=0.5
MIN_GIFT_USDC=0.1
RELAY_PER_MINUTE=20
# Optional hosted on-ramp URL; use {address} where the wallet address belongs.
RAMP_URL=

# Envio's Hasura GraphQL (the indexer's API)
HASURA_URL=http://localhost:8080/v1/graphql
HASURA_ADMIN_SECRET=

# Server
PORT=8787
TRUST_PROXY=1
# RPC_URL defaults to the chain's public RPC

# Test wallets for scripts (testnet only)
VIEWER_ADDRESS=
VIEWER_PRIVATE_KEY=
CREATOR_ADDRESS=
CREATOR_PRIVATE_KEY=
